# Copia este archivo a .env y rellena los valores
# Estos son los mínimos para que la app funcione (modo público/sin clave secreta):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Lo siguiente solo es necesario si vas a subir GIFs o correr scripts de migración:
# SUPABASE_SECRET_KEY=          # Clave secreta del proyecto (para scripts/DB)
# SUPABASE_JWKS_URL=          # URL JWKS para autenticación JWT opcional
# DBPASSWORD=                 # Contraseña de la base de datos (para migrations)
# DBURL=                      # URL directa de Postgres (alternativa a las migraciones)
# DIRECT_URL=                 # URL directa con service role key (para migrations)

# Ejemplo de uso sin exponer la clave secreta en la app:
# flutter run \
#   --dart-define=SUPABASE_URL="$SUPABASE_URL" \
#   --dart-define=SUPABASE_PUBLISHABLE_KEY="$SUPABASE_PUBLISHABLE_KEY"